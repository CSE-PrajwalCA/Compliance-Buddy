# API Configuration (Optional - for future backend integration)
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000

# Backend Endpoints
# /api/results - Get compliance validation results
# /api/emissions - Get CO2 emissions data
# /api/chat - Send chat messages to LLaMA 3-8B
# /api/report/download - Download compliance report

# Feature Flags (Optional)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# Environment
VITE_ENV=development
